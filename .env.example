# Groww Trade API (Backtesting endpoints need the paid Trading API subscription)
GROWW_API_KEY=
GROWW_API_SECRET=
# Optional: paste a ready token to skip the key+secret exchange (expires daily 6:00 AM IST)
GROWW_ACCESS_TOKEN=

# Control plane: bearer token the Next.js control app presents to the internal job API
MERIDIAN_WORKER_TOKEN=
# Durable job store root (defaults to runs/control)
MERIDIAN_CONTROL_ROOT=
# Research artifact root (defaults to data/research)
MERIDIAN_RESEARCH_ROOT=
# Source alias -> local directory mapping; one variable per alias
MERIDIAN_SOURCE_ROOT_MARKET_MINUTE_PRIMARY=
